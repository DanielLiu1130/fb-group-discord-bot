# ==========================================
# Facebook 二手拍賣 Discord 機器人環境變數範本
# 複製此檔案為 .env 後填入實際設定（.env 不會被 Git 追蹤）
# ==========================================

# 必填：Discord Bot Token
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# 必填（公開 Repo 請勿寫在程式內）：目標 Facebook 社團網址（多個可用英文逗號分隔）
TARGET_GROUPS=https://www.facebook.com/groups/YOUR_GROUP_ID

# 選填：Webhook 測試網址（僅 test_discord.py / monitor.py 使用）
DISCORD_WEBHOOK_URL=

# 本機 bot.py 背景巡邏間隔（分鐘）：每次在 MIN ~ MAX 之間隨機取樣
CHECK_INTERVAL_MIN_MINUTES=15
CHECK_INTERVAL_MAX_MINUTES=20

# 雲端 GitHub Actions 排程隨機延遲上限（秒，預設 300 秒 = 0~5 分鐘，搭配每 15 分鐘 cron 達成 15~20 分鐘隨機）
CLOUD_JITTER_MAX_SECONDS=300

# 每次檢查時頁面捲動次數
SCROLL_COUNT=2

# 選填：Cloudflare KV 設定（供 crawl_once.py / upload_session.py 使用）
# CF_ACCOUNT_ID=
# CF_KV_NAMESPACE_ID=
# CF_API_TOKEN=

# 選填：當 fb_session.json 失效時，允許系統自動嘗試重新登入一次
# 注意：若帳號開啟兩步驟驗證 (2FA) 或遇到安全檢查，系統會立即停止並通知您手動更新
# FB_EMAIL=
# FB_PASSWORD=

# 自動重登與 Discord 失效警告冷卻時間（分鐘，預設 360 = 6 小時）
AUTO_RELOGIN_COOLDOWN_MINUTES=360
AUTH_ALERT_COOLDOWN_MINUTES=360
