# ==========================================
# 本機一鍵上傳 FB 憑證到 Cloudflare KV 設定範本
# upload_session.bat 會在初次執行時引導您建立 cf_deploy.env
# （cf_deploy.env 已被 .gitignore 排除，切勿上傳到 Git）
# ==========================================

# Cloudflare Account ID（在 Cloudflare 首頁右側或 Workers 頁右側可複製）
CF_ACCOUNT_ID=

# Cloudflare KV Namespace ID（例如名為 fb-bot-kv 的命名空間 ID）
CF_KV_NAMESPACE_ID=

# 具備 Workers KV Storage: Edit 權限的 Cloudflare API Token
CF_API_TOKEN=
